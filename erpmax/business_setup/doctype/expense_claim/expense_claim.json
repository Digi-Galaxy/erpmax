{
 "doctype": "DocType",
 "name": "Expense Claim",
 "module": "Business Setup",
 "custom": 0,
 "is_submittable": 1,
 "fields": [
  {
   "fieldname": "employee",
   "label": "Employee",
   "fieldtype": "Link",
   "options": "Employee",
   "mandatory_depends_on": "eval:doc.claim_type==\"Employee Claim\""
  },
  {
   "fieldname": "employee_name",
   "label": "Employee Name",
   "fieldtype": "Data",
   "read_only": 1,
   "fetch_from": "employee.employee_name"
  },
  {
   "fieldname": "claim_type",
   "label": "Claim Type",
   "fieldtype": "Select",
   "options": "Employee Claim\nCompany Expense\nPetty Cash\nDaily Wages",
   "default": "Employee Claim",
   "reqd": 1
  },
  {
   "fieldname": "beneficiary_type",
   "label": "Beneficiary Type",
   "fieldtype": "Select",
   "options": "Employee\nSupplier\nWorker\nOther"
  },
  {
   "fieldname": "beneficiary_name",
   "label": "Beneficiary Name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "posting_date",
   "label": "Posting Date",
   "fieldtype": "Date",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "project",
   "label": "Project",
   "fieldtype": "Link",
   "options": "Project"
  },
  {
   "fieldname": "cost_center",
   "label": "Cost Center",
   "fieldtype": "Link",
   "options": "Cost Centre"
  },
  {
   "fieldname": "purpose",
   "label": "Purpose",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "column_break_ec1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_amount",
   "label": "Total Amount",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "total_tax_amount",
   "label": "Tax Amount",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nPending Approval\nApproved\nRejected\nPartly Paid\nPaid\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "section_approval",
   "label": "Approval",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "approved_by",
   "label": "Approved By",
   "fieldtype": "Link",
   "options": "User",
   "allow_on_submit": 1
  },
  {
   "fieldname": "approved_on",
   "label": "Approved On",
   "fieldtype": "Datetime",
   "allow_on_submit": 1,
   "read_only": 1
  },
  {
   "fieldname": "column_break_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "payment_status",
   "label": "Payment Status",
   "fieldtype": "Select",
   "options": "Unpaid\nPartly Paid\nPaid",
   "default": "Unpaid",
   "allow_on_submit": 1,
   "read_only": 1
  },
  {
   "fieldname": "rejection_reason",
   "label": "Rejection Reason",
   "fieldtype": "Small Text",
   "allow_on_submit": 1,
   "depends_on": "eval:doc.status==\"Rejected\""
  },
  {
   "fieldname": "section_expenses",
   "label": "Expense Details",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "expenses",
   "label": "Expenses",
   "fieldtype": "Table",
   "options": "Expense Claim Detail",
   "reqd": 1
  },
  {
   "fieldname": "section_accounting",
   "label": "Accounting",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "payable_account",
   "label": "Payable Account",
   "fieldtype": "Link",
   "options": "Account"
  },
  {
   "fieldname": "column_break_ec2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mode_of_payment",
   "label": "Mode of Payment",
   "fieldtype": "Select",
   "options": "Cash\nBank\nCheque"
  },
  {
   "fieldname": "petty_cash_account",
   "label": "Petty Cash Account",
   "fieldtype": "Link",
   "options": "Account",
   "depends_on": "eval:doc.claim_type==\"Petty Cash\"",
   "allow_on_submit": 1
  },
  {
   "fieldname": "payment_account",
   "label": "Payment Account",
   "fieldtype": "Link",
   "options": "Account",
   "allow_on_submit": 1
  },
  {
   "fieldname": "paid_amount",
   "label": "Paid Amount",
   "fieldtype": "Currency",
   "allow_on_submit": 1
  },
  {
   "fieldname": "payment_date",
   "label": "Payment Date",
   "fieldtype": "Date",
   "allow_on_submit": 1
  },
  {
   "fieldname": "payment_reference",
   "label": "Payment Reference",
   "fieldtype": "Data",
   "allow_on_submit": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "track_changes": 1,
 "search_fields": "employee,employee_name,beneficiary_name,project"
}
